@model List<Art_BaBomb.Web.Models.Receipt>
@using Art_BaBomb.Web.Helpers
@using Art_BaBomb.Web.Models

@{
    ViewData["Title"] = "Budget & Receipts";

    var project = ViewBag.Project as Project;
    var receipts = Model ?? new List<Receipt>();

    var totalSpent = (decimal?)ViewBag.TotalSpent ?? 0m;
    var remainingBudget = (decimal?)ViewBag.RemainingBudget ?? 0m;
}

<section class="project-hero mb-4">
    
    <div class="project-hero-main">
        <div class="eyebrow">Budget & Receipts</div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="project-hero-title mb-0">@project?.Name</h1>
        </div>

        <div class="project-hero-meta">
            <div>
                Track project spending and receipt documentation.
            </div>
        </div>
    </div>

    <div class="project-hero-actions">
        @if (User.IsInRole("Admin") || User.IsInRole("Shopper"))
        {
            <a asp-controller="Receipts" asp-action="Create" asp-route-projectId="@project?.Id" class="btn btn-art-primary">+ Add Receipt              
            </a>
        }

        <a asp-controller="Projects" asp-action="Details" asp-route-id="@project?.Id" class="btn btn-art-outline">
            Back to shopping
        </a>"
    </div>

</section>

<div class="page-alert-stack">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Project Budget</h6>
                <div class="fw-bold fs-4 text-end">
                    @(project?.Budget.ToString("C") ?? "$0.00")
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Receipt Total</h6>
                <div class="fw-bold fs-4 text-end">
                    @totalSpent.ToString("C")
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 @(remainingBudget < 0 ? "border-danger" : "")">
            <div class="card-body">
                <h6 class="text-muted">Remaining</h6>
                <div class="fw-bold fs-4 text-end @(remainingBudget < 0 ? "text-danger" : "")">
                    @remainingBudget.ToString("C")
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Receipts</h6>
                <div class="fw-bold fs-4 text-end">
                    @receipts.Count
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Receipt Ledger</h2>
    </div>

    @if (receipts.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Vendor</th>
                        <th class="text-end">Amount</th>
                        <th>Receipt</th>
                        <th>Notes</th>
                        <th class="actions-col"></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var receipt in receipts)
                    {
                        <tr>
                            <td class="text-nowrap">
                                @receipt.PurchaseDate.ToString("d")
                            </td>

                            <td>
                                <strong>@receipt.Vendor</strong>
                            </td>

                            <td class="text-end text-nowrap">
                                @receipt.TotalAmount.ToString("C")
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(receipt.ReceiptPath))
                                {
                                    <a href="@receipt.ReceiptPath"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(receipt.Notes)
                                    ? "—"
                                    : receipt.Notes)
                            </td>

                            <td>
                                <a asp-controller="Receipts"
                                   asp-action="Details"
                                   asp-route-id="@receipt.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <p class="project-empty-state mb-0">
                No receipts have been added yet.
            </p>
        </div>
    }
</div>